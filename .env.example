# Spring profile
SPRING_PROFILES_ACTIVE="prod"

# Production Compose must replace these with reviewed immutable tag-and-digest references.
WALLET_IMAGE=ghcr.io/goldeneraglobal/goldenera-wallet:sha-<full-commit-sha>@sha256:<manifest-digest>
POSTGRES_IMAGE=postgres:18.6-alpine@sha256:<reviewed-index-digest>

# Wallet PORT
LISTEN_PORT=8080

# PostgreSQL
POSTGRESQL_HOST="localhost"
POSTGRESQL_PORT=5432
POSTGRESQL_DB_NAME="wallet_db"
POSTGRESQL_USERNAME="postgres"
POSTGRESQL_PASSWORD="postgres"

# Security
# Admin
ADMIN_USERNAME="admin"
# Change this to a strong password!
ADMIN_PASSWORD="abc123"

# Nodes
NODE_BASE_URL=https://node1.example.com
NODE_API_KEY=sk_api_key
NODE_WEBHOOK_SECRET_KEY=webhook_secret_key
NODE_WEBHOOK_UID=replace_with_existing_webhook_uuid
NODE_CONNECT_TIMEOUT=2s
NODE_READ_TIMEOUT=3s

# Empty by default. Set only to the exact trusted reverse-proxy address regex.
TRUSTED_PROXY_REGEX=

# Logging
# Host bind source for the README Compose example; the container path stays /app/wallet_logs.
LOGGING_DIR="./wallet_logs"
LOGGING_FILE="wallet.log"
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_GLOBAL_GOLDENERA=INFO

# Throttling (api)

# GLOBAL SAFETY NET (Per IP) - Applied to EVERYTHING
# Allows 500 requests per second. Just to stop DDoS scripts.
THROTTLING_GLOBAL_CAPACITY=500
THROTTLING_GLOBAL_REFILL_TOKENS=500

# PUBLIC CORE (Per IP) - Unauthenticated access to Core
# Strict: 100 tokens capacity, refills 50 per second.
THROTTLING_PUBLIC_CORE_CAPACITY=100
THROTTLING_PUBLIC_CORE_REFILL_TOKENS=50

# Concurrent Core API admission (request count and conservative cached-body memory reservations)
THROTTLING_GLOBAL_IN_FLIGHT_REQUESTS=256
THROTTLING_GLOBAL_IN_FLIGHT_BYTES=268435456
THROTTLING_PER_IP_IN_FLIGHT_REQUESTS=32
THROTTLING_PER_IP_IN_FLIGHT_BYTES=67108864

# Retired device-registration rollout
# First release: keep mutations enabled while replacing every old backend replica.
# Second release/restart: disable mutations only after the old replicas have drained.
DEVICE_REGISTRATION_MUTATIONS_ENABLED=true
# Keep cleanup disabled until mutations are disabled everywhere and the 180-day
# retention window has elapsed. NULL last_seen_at rows are deliberately preserved.
DEVICE_CLEANUP_ENABLED=false
DEVICE_CLEANUP_BATCH_SIZE=500
DEVICE_CLEANUP_MAX_BATCHES_PER_RUN=100