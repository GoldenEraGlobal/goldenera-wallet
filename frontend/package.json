{
  "name": "frontend",
  "version": "1.0.1",
  "description": "GoldenEra Wallet Frontend Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build --filter=web",
    "lint": "eslint apps/web/src packages/*/src packages/api/kubb.config.ts apps/web/vite.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --filter=web",
    "generate": "pnpm --filter @project/api generate",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:assets": "node tests/tooling/pwa-assets.mjs",
    "sync:static": "node scripts/sync-static.mjs",
    "check:static": "node scripts/sync-static.mjs --check",
    "typecheck:compiler": "node scripts/typecheck.mjs --version"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.69.0",
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.11",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "vite": "^8.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {}
}
