    "/api/core/v1/wallet/transfers": {
      "get": {
        "tags": [
          "Wallet API V1"
        ],
        "summary": "Get transfer history",
        "description": "Get unified transfer history (pending first, then confirmed)",
        "operationId": "getTransfers",
        "parameters": [
          {
            "name": "addresses",
            "in": "query",
            "description": "1\u2013100 wallet addresses; an empty list is rejected",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          {
            "name": "tokenAddresses",
            "in": "query",
            "description": "At most 100 token addresses (optional; omitted means all tokens)",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          {
            "name": "transferType",
            "in": "query",
            "description": "Transfer type (optional, null for all types)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "TRANSFER",
                "BLOCK_FEES",
                "BLOCK_REWARD",
                "MINT",
                "BURN"
              ]
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Page number (0-indexed; pageNumber \u00d7 pageSize must not exceed 100000)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Page size, 1\u2013100",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "500": {
