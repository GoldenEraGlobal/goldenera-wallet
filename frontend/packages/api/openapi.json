  "components": {
    "schemas": {
      "TxSubmitDtoV1": {
        "type": "object",
        "description": "Transaction details",
        "properties": {
          "hexData": {
            "type": "string"
          }
        }
      },
      "MempoolResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SUCCESS",
              "QUEUED",
              "STALE",
              "REJECTED_FEE",
              "REJECTED_RBF",
              "REJECTED_STATE",
              "REJECTED_DUPLICATE",
              "REJECTED_NONCE_TOO_FAR_FUTURE",
              "REJECTED_MEMPOOL_FULL",
              "REJECTED_OTHER"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeviceRegistrationRequestDtoV1": {
        "type": "object",
        "properties": {
          "clientIdentifier": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "fcmToken": {
            "type": "string",
            "maxLength": 512,
            "minLength": 0
          },
          "appVersion": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          }
        },
        "required": [
          "clientIdentifier"
        ]
      },
      "DeviceDtoV1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientIdentifier": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "type": "string"
          },
          "fcmToken": {
            "type": "string"
          },
          "appVersion": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UnifiedTransferDtoV1": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED"
            ]
          },
          "txHash": {
            "type": "string"
          },
          "transferType": {
            "type": "string",
            "enum": [
              "TRANSFER",
              "BLOCK_FEES",
              "BLOCK_REWARD",
              "MINT",
              "BURN"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "tokenAddress": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "fee": {
            "type": "string"
          },
          "nonce": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "blockHeight": {
            "type": "integer",
            "format": "int64"
          },
          "blockHash": {
            "type": "string"
          },
          "confirmations": {
