{
  "name": "@project/api",
  "version": "1.0.0",
  "description": "GoldenEra Wallet API",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "types": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit -p tsconfig.json",
    "generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.90"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "^5.0.5",
    "@kubb/plugin-axios": "^5.1.1",
    "@kubb/plugin-react-query": "^5.0.1",
    "@kubb/plugin-ts": "^5.0.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "kubb": "^5.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
